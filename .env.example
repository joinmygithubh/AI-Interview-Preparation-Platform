NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/ai-interview-coach
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Optional: use any OpenAI-compatible provider. For Google Gemini (free tier
# available), get a key at https://aistudio.google.com/app/apikey and set:
#   OPENAI_API_KEY=your_gemini_api_key
#   OPENAI_MODEL=gemini-2.0-flash
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_BASE_URL=
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLIENT_URL=http://localhost:5173
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
FROM_EMAIL=no-reply@aiinterviewcoach.com
